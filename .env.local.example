# Copy to .env.local. Never commit your real token.
ACSL_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
ACSL_SHEETS_TOKEN=REPLACE_WITH_TOKEN_FROM_APPS_SCRIPT_PROPERTIES

# Google OAuth login: keep your existing Sheets values above.
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
